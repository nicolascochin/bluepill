#!/usr/bin/env bash
set -euo pipefail

# Directory containing the wallpapers
WALLPAPER_DIR="$HOME/Images/Wallpapers"

# Pick a random image file (jpg, jpeg, png, webp)
CURRENT_WALLPAPER=$(find "$WALLPAPER_DIR/" -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) | shuf -n 1)

# Exit if no wallpaper was found
if [ -z "$CURRENT_WALLPAPER" ]; then
    echo "No wallpaper found in $WALLPAPER_DIR" >&2
    exit 1
fi

# Apply the wallpaper for both light and dark modes
gsettings set org.gnome.desktop.background picture-uri "file://$CURRENT_WALLPAPER"
gsettings set org.gnome.desktop.background picture-uri-dark "file://$CURRENT_WALLPAPER"

