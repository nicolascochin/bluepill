#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<EOF
Usage:
    $0 <command> --image <image> [options]

Commands:
    run         Create the distrobox if needed, then enter it.
    destroy     Stop and remove the distrobox.

Options:
    -i, --image IMAGE    Docker/Podman image.
    -e, --ephemeral      Use distrobox ephemeral (run only).

All other options are forwarded to:
    - distrobox create
    - distrobox ephemeral

Examples:
    $0 run --image debian
    $0 run --image fedora:42
    $0 run --image archlinux --ephemeral
    $0 run --image debian --home ~/dbx/debian
    $0 destroy --image debian
EOF
    exit 1
}

[[ $# -ge 1 ]] || usage

COMMAND="$1"
shift

case "$COMMAND" in
    run|destroy)
        ;;
    *)
        usage
        ;;
esac

IMAGE=""
EPHEMERAL=false
EXTRA_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -i|--image)
            [[ $# -ge 2 ]] || usage
            IMAGE="$2"
            shift 2
            ;;
        -e|--ephemeral)
            EPHEMERAL=true
            shift
            ;;
        *)
            EXTRA_ARGS+=("$1")
            shift
            ;;
    esac
done

[[ -n "$IMAGE" ]] || usage

normalize_image() {
    local image="$1"

    [[ "$image" == *:* ]] || image="${image}:latest"

    IMAGE="$image"
    BASE_IMAGE="${IMAGE%:*}"
    NAME="distrobox-$(echo "$BASE_IMAGE" | sed 's|[^[:alnum:]]|-|g')"
}

distrobox_exists() {
    # Columns: ID | NAME | STATUS | IMAGE
    distrobox list --no-color \
        | awk -F'|' 'NR>1 {gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2); print $2}' \
        | grep -qx "$NAME"
}

# Packages passed to distrobox create, for images the dotfiles do not cover.
# Debian/Ubuntu and Fedora get theirs from the dotfiles lists
# (~/.config/packages), see install_dotfiles_packages.
packages_for_image() {
    local base="$1"

    case "$base" in
        debian|ubuntu*|fedora*)
            ;;
        archlinux*|arch)
            echo "zsh git curl base-devel"
            ;;
        alpine*)
            echo "zsh git curl build-base"
            ;;
        *)
            echo "zsh git"
            ;;
    esac
}

# Runs once, right after the distrobox has been created: installs the
# packages listed in the dotfiles, shared with the host through $HOME.
# The installer detects the distribution and skips the ones it does not know.
# The first `distrobox enter` also runs distrobox-init, so the container is
# ready when the installer starts.
install_dotfiles_packages() {
    local installer="$HOME/.local/bin/install-packages"

    if [[ ! -x "$installer" ]]; then
        echo "Warning: $installer not found (dotfiles not applied?), no extra packages installed." >&2
        return 0
    fi

    echo "Installing dotfiles packages in $NAME..."
    distrobox enter "$NAME" -- "$installer" \
        || echo "Warning: $installer failed in $NAME, run it again from inside the box." >&2
}

normalize_image "$IMAGE"
PACKAGES="$(packages_for_image "$BASE_IMAGE")"


case "$COMMAND" in
    destroy)
        if distrobox_exists; then
            echo "Stopping $NAME..."
            distrobox stop "$NAME" || true

            echo "Removing $NAME..."
            distrobox rm "$NAME"

            echo "Done."
        else
            echo "Distrobox '$NAME' does not exist."
        fi
        ;;

    run)
        if $EPHEMERAL; then
            exec distrobox ephemeral \
                --image "$IMAGE" \
                --additional-packages "zsh git" \
                "${EXTRA_ARGS[@]}"
        fi

        if ! distrobox_exists; then
            echo "Creating $NAME..."
            CREATE_ARGS=(--image "$IMAGE" --name "$NAME")
            if [[ -n "$PACKAGES" ]]; then
                CREATE_ARGS+=(--additional-packages "$PACKAGES")
            fi
            distrobox create "${CREATE_ARGS[@]}" "${EXTRA_ARGS[@]}"

            install_dotfiles_packages
        fi

        exec distrobox enter "$NAME"
        ;;
esac
