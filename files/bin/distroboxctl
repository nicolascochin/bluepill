#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<EOF
Usage:
    $0 <command> --image <image> [options]

Commands:
    run         Create the distrobox if needed, then enter it.
    destroy     Stop and remove the distrobox.

Options:
    -i, --image IMAGE    Docker/Podman image.
    -e, --ephemeral      Use distrobox ephemeral (run only).

All other options are forwarded to:
    - distrobox create
    - distrobox ephemeral

Examples:
    $0 run --image debian
    $0 run --image fedora:42
    $0 run --image archlinux --ephemeral
    $0 run --image debian --home ~/dbx/debian
    $0 destroy --image debian
EOF
    exit 1
}

[[ $# -ge 1 ]] || usage

COMMAND="$1"
shift

case "$COMMAND" in
    run|destroy)
        ;;
    *)
        usage
        ;;
esac

IMAGE=""
EPHEMERAL=false
EXTRA_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -i|--image)
            [[ $# -ge 2 ]] || usage
            IMAGE="$2"
            shift 2
            ;;
        -e|--ephemeral)
            EPHEMERAL=true
            shift
            ;;
        *)
            EXTRA_ARGS+=("$1")
            shift
            ;;
    esac
done

[[ -n "$IMAGE" ]] || usage

normalize_image() {
    local image="$1"

    [[ "$image" == *:* ]] || image="${image}:latest"

    IMAGE="$image"
    BASE_IMAGE="${IMAGE%:*}"
    NAME="distrobox-$(echo "$BASE_IMAGE" | sed 's|[^[:alnum:]]|-|g')"
}

distrobox_exists() {
    distrobox list --no-color | awk 'NR>1 {print $1}' | grep -qx "$NAME"
}

packages_for_image() {
    local base="$1"

    case "$base" in
        debian|ubuntu*)
            echo "zsh git curl build-essential command-not-found vim"
            ;;
        fedora*)
            echo "zsh git bat fd-find ripgrep python3-pygments rclone PackageKit-command-not-found"
            ;;
        archlinux*|arch)
            echo "zsh git curl base-devel"
            ;;
        alpine*)
            echo "zsh git curl build-base"
            ;;
        *)
            echo "zsh git"
            ;;
    esac
}

# Runs once, right after the distrobox has been created.
# The first `distrobox enter` also runs distrobox-init, which installs
# the additional packages before the command is executed.
post_create_for_image() {
    local base="$1"

    case "$base" in
        debian|ubuntu*)
            # command-not-found builds its database from the apt Contents
            # indexes, which are only downloaded by an apt update run after
            # the package is installed.
            echo "Updating apt indexes for command-not-found..."
            distrobox enter "$NAME" -- sudo apt-get update \
                || echo "Warning: apt-get update failed, command-not-found will stay empty until the next update." >&2
            ;;
    esac
}

normalize_image "$IMAGE"
PACKAGES="$(packages_for_image "$BASE_IMAGE")"


case "$COMMAND" in
    destroy)
        if distrobox_exists; then
            echo "Stopping $NAME..."
            distrobox stop "$NAME" || true

            echo "Removing $NAME..."
            distrobox rm "$NAME"

            echo "Done."
        else
            echo "Distrobox '$NAME' does not exist."
        fi
        ;;

    run)
        if $EPHEMERAL; then
            exec distrobox ephemeral \
                --image "$IMAGE" \
                --additional-packages "zsh git" \
                "${EXTRA_ARGS[@]}"
        fi

        if ! distrobox_exists; then
            echo "Creating $NAME..."
            distrobox create \
                --image "$IMAGE" \
                --name "$NAME" \
                --additional-packages "$PACKAGES" \
                "${EXTRA_ARGS[@]}"

            post_create_for_image "$BASE_IMAGE"
        fi

        exec distrobox enter "$NAME"
        ;;
esac
